import builtins
builtins.print('Mi calculadora')
num1 = float(builtins.input('Ingrese el primer número: '))
num2 = float(builtins.input('Ingrese el segundo número: '))
builtins.print("\nEscolha uma operação:")
builtins.print("1: Soma (+)")
builtins.print("2: Subtração (-)")
builtins.print("3: Multiplicação (*)")
builtins.print("4: Divisão (/)")

opcao = builtins.input("\nDigite o número da operação desejada: ")

if opcao == '1':
  resultado = num1 + num2
  builtins.print(f'\nResultado de la suma: {resultado}')
elif opcao == '2':
  resultado = num1 - num2
  builtins.print(f'\nResultado de la resta: {resultado}')
elif opcao == '3':
  resultado = num1 * num2
  builtins.print(f'\nResultado de la multiplicação: {resultado}')
elif opcao == '4':
  if num2 != 0:
       resultado = num1 / num2
       builtins.print(f'\nResultado de la división: {resultado}')
else:
       builtins.print('\nErro: No se puede dividir por cero.')